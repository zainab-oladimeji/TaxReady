# MongoDB (Atlas or self-hosted) — the single database for auth + business data
MONGODB_URI=
MONGODB_DB_NAME=taxready

# Auth.js — required. Generate with: npx auth secret
AUTH_SECRET=

# Google Sign-In (optional). Leave blank to offer email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud / Vertex AI (server-side only — never exposed to the client)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=europe-west4
GEMINI_MODEL=gemini-1.5-pro

# Optional — Cloud Storage bucket for receipt/invoice files (independent of
# the MongoDB switch; still uses Google Cloud Storage unless you replace it).
GOOGLE_CLOUD_STORAGE_BUCKET=

# If VERTEX_AI_PROJECT_ID and GOOGLE_CLOUD_PROJECT_ID are left blank, the app
# automatically falls back to MockAIProvider — see lib/ai/index.ts — so it
# stays fully demoable without any Google Cloud credentials.
#
# If MONGODB_URI is left blank, signed-in mode (real accounts, real data)
# will fail — but /demo still works fully in-memory with zero configuration.
