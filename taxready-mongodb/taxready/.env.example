# MongoDB (Atlas or self-hosted) — the single database for auth + business data
MONGODB_URI=
MONGODB_DB_NAME=taxready

# Error monitoring (Sentry). Free tier, no credit card, 5K errors/month.
# Create a project at sentry.io, then use its DSN for both of these (same
# value — one is exposed to the browser bundle, one stays server-only).
# Leave both blank and error monitoring simply no-ops; nothing else breaks.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional — only needed for uploading source maps (readable stack traces
# instead of minified ones in Sentry). Sentry → Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Auth.js — required. Generate with: npx auth secret
AUTH_SECRET=

# Google Sign-In (optional). Leave blank to offer email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RECOMMENDED if Google Cloud billing/card issues block you: Groq. Free,
# no credit card required, far more generous free-tier limits than
# Gemini's 20/day. Get a key at https://console.groq.com/keys — sign up
# with email or Google, no card needed. If set, this takes priority over
# everything below. See lib/ai/groq-provider.ts.
GROQ_API_KEY=
# Groq's free model lineup changes periodically — if you see a "model not
# found" or "decommissioned" error, check console.groq.com/docs/models and
# update these two, no code change needed.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Alternative: plain Gemini API key. No Google Cloud service account or
# Application Default Credentials needed — get a key at
# https://aistudio.google.com/apikey. Only used if GROQ_API_KEY above is
# not set. Free tier is capped at 20 requests/day; needs Google Cloud
# billing linked for real usage. See lib/ai/gemini-api-provider.ts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Google Cloud / Vertex AI (server-side only — never exposed to the client)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=europe-west4

# Optional — Cloud Storage bucket for receipt/invoice files (independent of
# the MongoDB switch; still uses Google Cloud Storage unless you replace it).
GOOGLE_CLOUD_STORAGE_BUCKET=

# If VERTEX_AI_PROJECT_ID and GOOGLE_CLOUD_PROJECT_ID are left blank, the app
# automatically falls back to MockAIProvider — see lib/ai/index.ts — so it
# stays fully demoable without any Google Cloud credentials.
#
# If MONGODB_URI is left blank, signed-in mode (real accounts, real data)
# will fail — but /demo still works fully in-memory with zero configuration.
